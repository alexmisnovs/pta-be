        "files",
        "videos",
        "audios"
      ]
    },
    "blocks": {
      "type": "dynamiczone",
      "components": [
        "shared.rich-text",
        "shared.quote",
        "shared.media"
      ]
    },
    "donationGoal": {
      "type": "integer"
    },
    "donationReceived": {
      "type": "integer"
    },
    "slug": {
      "type": "uid",
      "targetField": "heading"
    }
  }
